# Aidit-Code 백엔드 환경설정 예시(.env.example)
# 실제 값은 backend/.env 에만 둔다. 이 파일은 키를 담지 않는 견본이다.
# 단일 출처: src/config.ts(읽기 + redaction). 값 누락 시 아래 "기본값"으로 폴백한다.

# ── 서버 바인딩 ─────────────────────────────────────────────
# HTTP 리슨 포트. 기본 3001. (프론트 Vite 프록시 타깃과 일치시킬 것.)
PORT="3001"
# 바인드 호스트. 기본 0.0.0.0(IPv4 전용). 내부 전용은 127.0.0.1.
# 권장 "::"(듀얼스택 IPv4+IPv6) — Windows 에서 Vite 프록시가 localhost 를 ::1 로 해석할 때
# IPv4 전용 바인딩과 불일치해 발생하는 연결 거부(피드 "네트워크 오류")를 방지한다.
HOST="::"

# ── 데이터베이스(Prisma) ────────────────────────────────────
# Prisma 데이터소스 URL. 기본은 로컬 SQLite 파일(file:./prisma/dev.db).
DATABASE_URL="file:./prisma/dev.db"

# ── 인증(JWT) ───────────────────────────────────────────────
# JWT 서명 비밀키. 운영에서는 반드시 강한 난수로 교체할 것(절대 로그/응답 노출 금지).
JWT_SECRET="dev-secret-change-me"
# 액세스 토큰 만료. (예: "7d", "12h") 기본 7d.
JWT_EXPIRES="7d"

# ── LLM 런타임(TRD §2·§8 — 키는 서버 .env 에만, 클라/로그/응답에 절대 노출 금지) ──
# OpenAI-compatible 엔드포인트 베이스 URL. 에이전트 워커가 {BASE_URL}/chat/completions 로 스트리밍 호출.
BASE_URL="https://models.github.ai/inference"
# 활성 모델명(공급자 프리픽스 포함). GitHub Models 예: openai/gpt-4o-mini.
MODEL="openai/gpt-4o-mini"
# 운영자 LLM 키. 반드시 실제 키로 교체. 워커 프로세스 ENV(OPENAI_API_KEY/PI_API_KEY)로만 주입된다.
# (NOTE) 키/baseURL/model 이 비어 있으면 에이전트는 실 LLM 대신 결정적 에코 스텁으로 동작한다.
API_KEY="REPLACE_ME"

# ── 에이전트 런타임(AR-PI / piWorker) ───────────────────────
# 사용할 런타임 어댑터 식별자. 기본 'pi'(현재 유일 — piWorker.mjs 자식 프로세스).
AGENT_RUNTIME="pi"
# 워커가 'ready' 를 알릴 때까지의 spawn 대기 상한(ms). 기본 5000.
AGENT_READY_TIMEOUT_MS="5000"
# 실 LLM 호출(초기 응답 + 스트림 수신) 전체의 벽시계 상한(ms). 기본 60000.
# 초과 시 호출을 abort 하고 턴을 FAILED 로 마감 → 도달 불가/지연 엔드포인트로 인한 무한 RUNNING 방지.
AGENT_LLM_TIMEOUT_MS="60000"
# '1' 이면 실 LLM 대신 결정적 에코 스텁을 강제(테스트/오프라인 데모용). 기본은 자동 판단.
# (테스트 실행 VITEST/NODE_ENV=test 또는 자격증명 누락 시에도 자동으로 스텁 모드가 된다.)
AGENT_STUB="0"
# 스텁 모드에서 에코 토큰 사이 지연(ms). PoC 타이핑 효과/테스트 속도용. 기본 8.
AGENT_TOKEN_DELAY_MS="8"
# (참고) OPENAI_*/PI_*/LANG_HINT 는 서버가 위 BASE_URL/MODEL/API_KEY 와 요청 lang 으로부터
#        워커 프로세스에 자동 주입한다 — 여기서 직접 설정하지 않는다.

# ── 실시간 스트림(SSE) ──────────────────────────────────────
# SSE heartbeat 주기(ms). 프록시/브라우저 idle 타임아웃으로 끊기지 않도록 코멘트 프레임 전송. 기본 15000.
SSE_HEARTBEAT_MS="15000"

# ── 샌드박스 프로비저닝/격리 루트 ───────────────────────────
# 샌드박스 격리 루트(호스트 절대경로). 미설정 시 리포 루트의 .sandboxes/ 사용.
# SANDBOX_ROOT="/abs/path/to/.sandboxes"
# 동시 샌드박스 프로비저닝/활성 실행 상한(TRD §8 남용 방지). 초과 시 429. 기본 4.
SANDBOX_MAX_CONCURRENT="4"

# ── M7 XC-RATE: 쓰기 라우트 인메모리 레이트리밋(TRD §8 남용 방지) ──
# '1' 이면 레이트리밋 완전 비활성(테스트/스모크용). 기본은 활성('0').
RATE_LIMIT_DISABLED="0"
# 고정 윈도우 길이(ms). 기본 60000.
RATE_LIMIT_WINDOW_MS="60000"
# GENEROUS 한도 — 정상 흐름/기존 테스트를 막지 않는다.
# 윈도우당 POST /posts 허용 횟수(userId+ip). 초과 시 429.
RATE_LIMIT_POSTS_PER_WINDOW="30"
# 윈도우당 POST /posts/:id/messages 허용 횟수(userId+ip). 초과 시 429.
RATE_LIMIT_MESSAGES_PER_WINDOW="120"

# ── M7 XC-ISO: 샌드박스 격리 하드닝(best-effort PoC, TRD §8) ──
# SHELL/PACKAGE 도구 벽시계 타임아웃(ms). 초과 시 child kill → ToolCall FAILED 'timeout'. 기본 30000.
TOOL_TIMEOUT_MS="30000"
# 샌드박스당 동시 실행 자식 프로세스 상한(best-effort cap). 기본 16.
SANDBOX_MAX_PROCS="16"
# 네트워크 정책 플래그: restricted | open. 메타에 기록만(실제 강제는 범위 외 — deferred). 기본 restricted.
NETWORK_POLICY="restricted"
