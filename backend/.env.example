DATABASE_URL="file:./prisma/dev.db"
JWT_SECRET="dev-secret-change-me"
JWT_EXPIRES="7d"
BASE_URL="https://models.github.ai/inference"
MODEL="openai/gpt-4o-mini"
API_KEY="REPLACE_ME"

SANDBOX_MAX_CONCURRENT="4"

# ── M7 XC-RATE: 쓰기 라우트 인메모리 레이트리밋(TRD §8 남용 방지) ──
# RATE_LIMIT_DISABLED=1 이면 완전 비활성(테스트/스모크용). 기본은 활성.
RATE_LIMIT_DISABLED="0"
RATE_LIMIT_WINDOW_MS="60000"
# GENEROUS 한도 — 정상 흐름/기존 테스트를 막지 않는다.
RATE_LIMIT_POSTS_PER_WINDOW="30"
RATE_LIMIT_MESSAGES_PER_WINDOW="120"

# ── M7 XC-ISO: 샌드박스 격리 하드닝(best-effort PoC, TRD §8) ──
# SHELL/PACKAGE 도구 벽시계 타임아웃(ms). 초과 시 child kill → ToolCall FAILED 'timeout'.
TOOL_TIMEOUT_MS="30000"
# 샌드박스당 동시 실행 자식 프로세스 상한(best-effort cap).
SANDBOX_MAX_PROCS="16"
# 네트워크 정책 플래그: restricted | open. 메타에 기록만(실제 강제는 범위 외 — deferred).
NETWORK_POLICY="restricted"
