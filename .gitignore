# Secrets — 절대 커밋 금지 (TRD §2·§8: LLM 키는 서버 .env 에만)
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
out/
*.tsbuildinfo

